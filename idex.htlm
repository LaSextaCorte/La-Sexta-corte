<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>La Sexta Corte</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background: #0b0b0b;
      color: white;
    }

    header {
      height: 75px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 7%;
      border-bottom: 1px solid #292929;
      background: #0b0b0b;
    }

    .logo {
      font-size: 24px;
      font-weight: bold;
      letter-spacing: 2px;
    }

    .logo span {
      color: #d4af37;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin-left: 25px;
    }

    nav a:hover {
      color: #d4af37;
    }

    .hero {
      min-height: 600px;
      display: flex;
      align-items: center;
      padding: 70px 7%;
      background: linear-gradient(
        135deg,
        #0b0b0b 0%,
        #17130a 50%,
        #0b0b0b 100%
      );
    }

    .hero-content {
      max-width: 700px;
    }

    .small-title {
      color: #d4af37;
      letter-spacing: 4px;
      font-size: 14px;
      margin-bottom: 20px;
    }

    h1 {
      font-size: 80px;
      line-height: 0.95;
      margin-bottom: 25px;
    }

    h1 span {
      color: #d4af37;
    }

    .description {
      color: #b5b5b5;
      font-size: 18px;
      line-height: 1.6;
      max-width: 600px;
      margin-bottom: 35px;
    }

    .button {
      display: inline-block;
      background: #d4af37;
      color: #000;
      padding: 16px 28px;
      text-decoration: none;
      font-weight: bold;
      border-radius: 4px;
    }

    .button:hover {
      background: #f0ce55;
    }

    .services {
      padding: 80px 7%;
      background: #111;
    }

    .title {
      text-align: center;
      margin-bottom: 45px;
    }

    .title p {
      color: #d4af37;
      letter-spacing: 3px;
      margin-bottom: 10px;
    }

    .title h2 {
      font-size: 40px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      max-width: 1100px;
      margin: auto;
    }

    .card {
      background: #1a1a1a;
      padding: 30px;
      border: 1px solid #292929;
    }

    .card:hover {
      border-color: #d4af37;
    }

    .card h3 {
      margin-bottom: 15px;
      font-size: 22px;
    }

    .card p {
      color: #999;
      line-height: 1.5;
      margin-bottom: 20px;
    }

    .price {
      color: #d4af37;
      font-size: 20px;
      font-weight: bold;
    }

    .booking {
      text-align: center;
      padding: 90px 7%;
      background: #0b0b0b;
    }

    .booking h2 {
      font-size: 42px;
      margin-bottom: 15px;
    }

    .booking p {
      color: #999;
      margin-bottom: 30px;
    }

    footer {
      text-align: center;
      padding: 30px;
      border-top: 1px solid #292929;
      color: #777;
    }

    @media (max-width: 700px) {
      h1 {
        font-size: 55px;
      }

      .cards {
        grid-template-columns: 1fr;
      }

      nav {
        padding: 0 5%;
      }

      nav a {
        display: none;
      }
    }
  </style>
</head>

<body>

  <header>

    <div class="logo">
      LA SEXTA <span>CORTE</span>
    </div>

    <nav>
      <a href="#inicio">Inicio</a>
      <a href="#servicios">Servicios</a>
      <a href="#reservar">Reservar</a>
    </nav>

  </header>


  <section class="hero" id="inicio">

    <div class="hero-content">

      <div class="small-title">
        BARBERÍA & ESTILO
      </div>

      <h1>
        TU ESTILO.<br>
        <span>TU CORTE.</span>
      </h1>

      <p class="description">
        Bienvenido a La Sexta Corte.
        Reserva tu próxima cita de manera rápida,
        sencilla y segura.
      </p>

      <a href="#reservar" class="button">
        RESERVAR CITA
      </a>

    </div>

  </section>


  <section class="services" id="servicios">

    <div class="title">

      <p>NUESTROS SERVICIOS</p>

      <h2>Elige tu estilo</h2>

    </div>


    <div class="cards">

      <div class="card">

        <h3>✂️ Corte</h3>

        <p>
          Corte personalizado realizado
          por nuestros barberos.
        </p>

        <div class="price">
          $25.000
        </div>

      </div>


      <div class="card">

        <h3>🧔 Barba</h3>

        <p>
          Perfilado y arreglo de barba
          para complementar tu estilo.
        </p>

        <div class="price">
          $15.000
        </div>

      </div>


      <div class="card">

        <h3>🔥 Corte + Barba</h3>

        <p>
          El servicio completo para renovar
          tu estilo.
        </p>

        <div class="price">
          $35.000
        </div>

      </div>

    </div>

  </section>


  <section class="booking" id="reservar">

    <h2>
      ¿Listo para tu próximo corte?
    </h2>

    <p>
      Muy pronto podrás reservar tu cita directamente desde aquí.
    </p>

    <a href="#" class="button">
      RESERVAR AHORA
    </a>

  </section>


  <footer>

    © 2026 La Sexta Corte

  </footer>

</body>
</html>
